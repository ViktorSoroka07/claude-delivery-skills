.DS_Store
*.zip
.idea
# local-only leak wordlist - must never be published
.leakwords.local
.leakguard_fail
.claude/

# review-pr findings are point-in-time, untracked by convention
review-findings-*.md

__pycache__/
*.pyc

# plan docs are local working artifacts here, by owner decision
docs/plans/

# machine-specific session hints; CLAUDE.md carries the repo's own
CLAUDE.local.md

# plugin eval run output
evals/results/

# a replay case's continuation transcript: the runner writes one file per
# invocation into the case directory, named for the seeded session id and
# holding every rep's turns branched off the seed, thick with the sandbox's own
# environment. The fixture itself is tracked.
evals/*/*.jsonl
!evals/*/history.jsonl
