.DS_Store
*.zip
.idea
# local-only leak wordlist - must never be published
.leakwords.local
.leakguard_fail
.claude/

# review-pr findings are point-in-time, untracked by convention
review-findings-*.md

__pycache__/
*.pyc

# plan docs are local working artifacts here, by owner decision
docs/plans/

# machine-specific session hints; CLAUDE.md carries the repo's own
CLAUDE.local.md

# plugin eval run output
evals/results/

# a replay case's continuation transcripts: the runner writes one per rep into
# the case directory, beside the fixture it resumes from, each thick with the
# sandbox's own environment. The fixture itself is tracked.
evals/*/*.jsonl
!evals/*/history.jsonl
