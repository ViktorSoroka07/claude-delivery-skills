#!/bin/sh
# Blocks internal identifiers from entering this repository.
#
# Two tiers of pattern:
#   - STRUCTURAL patterns live here, in the committed hook. They describe the
#     *shape* of internal data (ticket ids, internal hosts, ticket URLs) and
#     name nothing, so this file is safe to publish.
#   - LITERAL names (codenames, private repo names) live in .leakwords.local,
#     which is gitignored and never published. Writing them here would leak
#     the very words the hook exists to catch.
#
# Bypass with --no-verify only when you are certain. Run scripts/scan-history.sh
# before pushing to audit the whole history, not just this commit.

rm -f .leakguard_fail
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

report() { printf '  %-7s %s\n' "$1" "$2"; }

# --- BLOCK: structural patterns that are never legitimate here -------------
block_patterns='
AB#[0-9]+
dev\.azure\.com/[A-Za-z0-9]
[A-Za-z0-9-]+\.visualstudio\.com
[0-9]{4}-[0-9]{2}-[0-9]{2}
'

printf '%s\n' "$block_patterns" | while IFS= read -r p; do
  [ -z "$p" ] && continue
  hits=$(git diff --cached -U0 | grep -E '^\+' | grep -v -e '^+++' | grep -nEi "$p")
  if [ -n "$hits" ]; then
    [ ! -f .leakguard_fail ] && echo "BLOCKED - internal data in staged changes:"
    report "BLOCK" "matches /$p/"
    printf '%s\n' "$hits" | sed 's/^/          /' | cut -c1-140
    : > .leakguard_fail
  fi
done

# --- BLOCK: literal names from the untracked local wordlist ---------------
# .leakwords.local is user-created and may carry CRLF endings (a Windows
# editor); a trailing \r on a term makes it silently match nothing.
CR=$(printf '\r')
if [ -f .leakwords.local ]; then
  while IFS= read -r w; do
    w=${w%"$CR"}
    case "$w" in ''|\#*) continue ;; esac
    hits=$(git diff --cached -U0 | grep -E '^\+' | grep -v -e '^+++' | grep -nFi "$w")
    if [ -n "$hits" ]; then
      [ ! -f .leakguard_fail ] && echo "BLOCKED - internal data in staged changes:"
      report "BLOCK" "matches a term in .leakwords.local"
      printf '%s\n' "$hits" | sed 's/^/          /' | cut -c1-140
      : > .leakguard_fail
    fi
  done < .leakwords.local
else
  echo "NOTE: .leakwords.local is missing - literal codename checks are OFF."
  echo "      Create it (one term per line); it is gitignored."
fi

# --- BLOCK: SKILL.md frontmatter a strict YAML parser rejects -------------
# The harness loads frontmatter leniently, so a break like a colon-space
# inside an unquoted scalar still works locally - and then fails the spec
# validator in CI after push (this class shipped twice). Full parse where
# python3 with PyYAML exists; a structural check for the known class
# otherwise - CI's validator remains the authority.
printf '%s\n' "$staged" | grep 'SKILL\.md$' | while IFS= read -r f; do
  [ -z "$f" ] && continue
  fm=$(git show ":$f" | sed -n '1,/^---$/p' | sed '1d;$d')
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1; then
    bad=$(printf '%s\n' "$fm" | python3 -c 'import sys, yaml
try: yaml.safe_load(sys.stdin.read())
except yaml.YAMLError as e: print(str(e).replace("\n", " ")[:140])')
  else
    bad=$(printf '%s\n' "$fm" | grep -nE '^[A-Za-z_-]+:[[:space:]].*:[[:space:]]' \
      | grep -vE '^[0-9]+:[A-Za-z_-]+:[[:space:]]*["'\'']' | head -1)
    [ -n "$bad" ] && bad="unquoted scalar contains ': ' - $bad"
  fi
  if [ -n "$bad" ]; then
    echo "BLOCKED - $f frontmatter fails strict YAML:"
    printf '          %s\n' "$bad" | cut -c1-150
    : > .leakguard_fail
  fi
done

# --- WARN: shapes that are usually, but not always, a leak ----------------
warn_patterns='
\bPR #?[0-9]{2,}
\b[0-9a-f]{7,40}\b
'
# A generated marker region carries a verbatim copy of text this hook already
# scans in the file that owns it, so a shape inside it was judged once at its
# source. Warning on the copy fires again on every regeneration, and a warning
# that always fires is one nobody reads. Only the copy is exempt: a shape
# hand-planted in the region is still caught by the history scanner, and the
# generator reverts it.
GENERATED=$(mktemp)
printf '%s\n' "$staged" | grep -E '\.md$' | while IFS= read -r f; do
  [ -z "$f" ] && continue
  git show ":$f" 2>/dev/null | awk '
    /<!-- \/triggers -->/ { g=0 }
    g                      { print }
    /<!-- triggers -->/    { g=1 }'
done > "$GENERATED"
warn_added=$(git diff --cached -U0 | grep -E '^\+' | grep -v -e '^+++' | sed 's/^+//' \
  | grep -Fxv -f "$GENERATED")
rm -f "$GENERATED"

printf '%s\n' "$warn_patterns" | while IFS= read -r p; do
  [ -z "$p" ] && continue
  hits=$(printf '%s\n' "$warn_added" | grep -nEi "$p")
  if [ -n "$hits" ]; then
    echo "WARNING - check these before publishing:"
    report "WARN" "matches /$p/"
    printf '%s\n' "$hits" | sed 's/^/          /' | cut -c1-140
  fi
done

if [ -f .leakguard_fail ]; then
  rm -f .leakguard_fail
  echo
  echo "Commit refused. Remove the identifiers, or use --no-verify if you are sure."
  exit 1
fi
exit 0
